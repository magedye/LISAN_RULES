{
  "lisan_status": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "lisan_get_verses": {
    "type": "object",
    "properties": {
      "refs": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 3,
          "maxLength": 8,
          "pattern": "^[1-9][0-9]{0,2}:[1-9][0-9]{0,3}$"
        },
        "minItems": 1,
        "maxItems": 50,
        "uniqueItems": true
      },
      "context": {
        "type": "integer",
        "minimum": 0,
        "maximum": 5
      }
    },
    "required": [
      "refs"
    ],
    "additionalProperties": false
  },
  "lisan_search": {
    "type": "object",
    "properties": {
      "query": {
        "type": "object",
        "properties": {
          "forms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true
          },
          "match": {
            "enum": [
              "TOKEN",
              "SUBSTRING"
            ]
          },
          "normalization": {
            "enum": [
              "EXACT",
              "ARABIC_MARKS_V1"
            ]
          }
        },
        "required": [
          "forms",
          "match",
          "normalization"
        ],
        "additionalProperties": false
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "maximum": 20000
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      }
    },
    "required": [
      "query"
    ],
    "additionalProperties": false
  },
  "lisan_verify_quote": {
    "type": "object",
    "properties": {
      "ref": {
        "type": "string",
        "minLength": 3,
        "maxLength": 8,
        "pattern": "^[1-9][0-9]{0,2}:[1-9][0-9]{0,3}$"
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384
      },
      "kind": {
        "enum": [
          "FULL",
          "EXCERPT"
        ]
      }
    },
    "required": [
      "ref",
      "text",
      "kind"
    ],
    "additionalProperties": false
  },
  "lisan_validate_analysis": {
    "type": "object",
    "properties": {
      "record": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": "2.0"
          },
          "corpus_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "kind": {
                  "enum": [
                    "DIRECT_TEXT",
                    "OBSERVATION",
                    "SUPPORTED_INFERENCE",
                    "TENTATIVE_HYPOTHESIS",
                    "COUNT"
                  ]
                },
                "statement": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "ref": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 8,
                        "pattern": "^[1-9][0-9]{0,2}:[1-9][0-9]{0,3}$"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16384
                      },
                      "kind": {
                        "enum": [
                          "FULL",
                          "EXCERPT"
                        ]
                      },
                      "source_kind": {
                        "const": "QURAN"
                      }
                    },
                    "required": [
                      "ref",
                      "text",
                      "kind",
                      "source_kind"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0,
                  "maxItems": 50
                },
                "warrant": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 8192
                },
                "count": {
                  "type": "object",
                  "properties": {
                    "query": {
                      "type": "object",
                      "properties": {
                        "forms": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          },
                          "minItems": 1,
                          "maxItems": 32,
                          "uniqueItems": true
                        },
                        "match": {
                          "enum": [
                            "TOKEN",
                            "SUBSTRING"
                          ]
                        },
                        "normalization": {
                          "enum": [
                            "EXACT",
                            "ARABIC_MARKS_V1"
                          ]
                        }
                      },
                      "required": [
                        "forms",
                        "match",
                        "normalization"
                      ],
                      "additionalProperties": false
                    },
                    "unit": {
                      "enum": [
                        "VERSES",
                        "MATCH_EVENTS"
                      ]
                    },
                    "value": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000000
                    }
                  },
                  "required": [
                    "query",
                    "unit",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "kind",
                "statement",
                "evidence",
                "warrant"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 100
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "minItems": 0,
            "maxItems": 50
          }
        },
        "required": [
          "schema_version",
          "corpus_sha256",
          "claims",
          "limitations"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "record"
    ],
    "additionalProperties": false
  }
}
