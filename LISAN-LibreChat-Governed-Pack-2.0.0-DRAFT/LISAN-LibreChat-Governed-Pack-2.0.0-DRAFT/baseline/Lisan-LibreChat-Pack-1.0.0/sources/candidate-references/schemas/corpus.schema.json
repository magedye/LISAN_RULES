{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "verses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "surah_id": {
            "type": "integer",
            "minimum": 1
          },
          "ayah_id": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "surah_id",
          "ayah_id",
          "text"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "corpus_id",
    "verses"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved Quran corpus wrapper — structure only",
  "description": "Does not establish authenticity, reference uniqueness, completeness or semantic meaning. Text must be supplied from an owner-approved source; the package contains no Quran corpus."
}
