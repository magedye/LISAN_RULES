{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "forms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    },
    "match": {
      "enum": [
        "TOKEN",
        "SUBSTRING"
      ]
    },
    "normalization": {
      "enum": [
        "EXACT",
        "ARABIC_MARKS_V1"
      ]
    }
  },
  "required": [
    "forms",
    "match",
    "normalization"
  ],
  "additionalProperties": false
}
